# Copy to .env and fill in. Never commit .env. Every service runs on its free tier.

# Express API (Vercel)
DATABASE_URL=            # Neon pooled connection string, Singapore region
SESSION_SECRET=          # 32+ random bytes, signs the session cookie
APP_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=        # Google Cloud OAuth client ID for Sign in with Google
VITE_GOOGLE_CLIENT_ID=   # Same value; public, read by the frontend
RESEND_API_KEY=          # Optional email verification and password reset
MAIL_FROM=Scribb <hello@scribb.xyz>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared by Express and the AI service
AI_TICKET_SECRET=        # 32+ random bytes, different from SESSION_SECRET
AI_URL=http://localhost:8000   # on Vercel: /ai, the scribb-ai service on the same origin
AI_ENABLED=true

# AI service (Render)
AI_DATABASE_URL=         # Neon connection string for the restricted read-only AI role
GEMINI_API_KEY=          # Google AI Studio, free tier
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=
GEMINI_LIVE_MODEL=gemini-3.8-live
ALLOWED_ORIGINS=http://localhost:5173,https://scribb.xyz
