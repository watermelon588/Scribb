# Local template. Never commit filled values. Production instructions: docs/DEPLOYMENT.md.
# Set hosted secrets in the Vercel / Render dashboards, never in frontend code.

# Express API (Vercel)
DATABASE_URL=            # Neon owner/app connection string, Singapore region
SESSION_SECRET=          # 32+ random bytes, signs the session cookie
APP_ORIGIN=http://localhost:5173
# Production APP_ORIGIN must be your exact https://project.vercel.app or custom domain.
GOOGLE_CLIENT_ID=        # Google Cloud OAuth client ID for Sign in with Google
VITE_GOOGLE_CLIENT_ID=   # Same value; public, read by the frontend
RESEND_API_KEY=          # Optional email verification and password reset
MAIL_FROM=Scribb <hello@scribb.xyz>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared by Express and the AI service
AI_TICKET_SECRET=        # 32+ random bytes, different from SESSION_SECRET
AI_URL=http://localhost:8000
AI_ENABLED=false

# AI service (Render)
AI_DATABASE_URL=         # Neon connection string for the restricted read-only AI role
GEMINI_API_KEY=          # Google AI Studio, free tier
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=
ALLOWED_ORIGINS=http://localhost:5173
# Render ALLOWED_ORIGINS must be exact HTTPS site origins (comma-separated, no trailing slash).
# Optional limits. Never set LOCAL_ONLY or RATE_LIMITS=off in hosted environments.
MEDIA_QUOTA_MB=300
AI_DAILY_QUOTA=20
AI_GLOBAL_DAILY=300
