{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "types": ["node"],
    "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "isolatedModules": true, "noEmit": true,
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["."]
}
